# Use Eclipse Temurin for both build and runtime stages
FROM eclipse-temurin:21-jdk AS builder

# 添加构建参数，默认使用标准模型
ARG VOSK_MODEL_SIZE=standard
# 添加语言参数，默认使用中文模型，可选：cn 或 en
ARG VOSK_MODEL_LANG=en

# 安装必要的构建工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    maven \
    wget \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 复制源代码
COPY ./src ./src
COPY ./db ./db
COPY pom.xml ./
# 构建应用
RUN mvn -Dmaven.repo.local=/root/.m2/repository package -DskipTests

# 正确提取项目版本号 - 使用更精确的grep模式匹配项目版本而非父项目版本
RUN APP_VERSION=$(grep -A1 "<artifactId>xiaozhi.server</artifactId>" pom.xml | grep "<version>" | sed -e 's/<version>//' -e 's/<\/version>//' -e 's/[[:space:]]//g') && \
    echo "APP_VERSION=${APP_VERSION}" > /build/app_version.env && \
    cat /build/app_version.env

# 确保模型目录存在
RUN mkdir -p /build/models

# 只复制必要的模型文件（不包含 zip 文件）
COPY ./models/silero_vad.onnx /build/models/silero_vad.onnx

# 复制 models 目录到临时位置（用于检查 zip 文件是否存在，后续会在同一RUN中删除，不会进入最终layer）
# 如果 models 目录中只有 silero_vad.onnx，此 COPY 会复制它（冗余但无害，后续会删除整个目录）
# 如果 models 目录中有 zip 文件，会被复制到这里供后续使用
COPY ./models /build/models_temp

# 下载并准备Vosk模型（在单个RUN中完成：下载→解压→复制→删除，避免zip文件进入layer）
# 支持从构建上下文的 models 目录读取 zip 文件，如果不存在则从网络下载
# 所有操作在临时目录完成，zip文件和解压目录都在同一RUN中创建和删除，不会进入layer
RUN TEMP_DIR=$(mktemp -d) && \
    if [ "$VOSK_MODEL_SIZE" = "small" ]; then \
        # small 模式：目前只支持中文模型 \
        if [ "$VOSK_MODEL_LANG" = "en" ]; then \
            echo "Warning: small model only supports Chinese, using Chinese model instead"; \
            MODEL_NAME="vosk-model-small-cn-0.22"; \
            MODEL_FILE="vosk-model-small-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-small-cn-0.22.zip"; \
        else \
            MODEL_NAME="vosk-model-small-cn-0.22"; \
            MODEL_FILE="vosk-model-small-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-small-cn-0.22.zip"; \
        fi && \
        cd ${TEMP_DIR} && \
        if [ -f "/build/models_temp/${MODEL_FILE}" ]; then \
            echo "Using ${MODEL_FILE} from build context..." && \
            cp /build/models_temp/${MODEL_FILE} .; \
        else \
            echo "Downloading ${MODEL_FILE} from network..." && \
            wget ${MODEL_URL}; \
        fi && \
        unzip ${MODEL_FILE} && \
        cp -r ${MODEL_NAME} /build/models/vosk-model && \
        cd / && \
        rm -rf ${TEMP_DIR} && \
        rm -rf /build/models_temp; \
    else \
        # standard 模式：根据语言参数选择模型 \
        if [ "$VOSK_MODEL_LANG" = "en" ]; then \
            MODEL_NAME="vosk-model-en-us-0.22"; \
            MODEL_FILE="vosk-model-en-us-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-en-us-0.22.zip"; \
        else \
            MODEL_NAME="vosk-model-cn-0.22"; \
            MODEL_FILE="vosk-model-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-cn-0.22.zip"; \
        fi && \
        cd ${TEMP_DIR} && \
        if [ -f "/build/models_temp/${MODEL_FILE}" ]; then \
            echo "Using ${MODEL_FILE} from build context..." && \
            cp /build/models_temp/${MODEL_FILE} .; \
        else \
            echo "Downloading ${MODEL_FILE} from network..." && \
            wget ${MODEL_URL}; \
        fi && \
        unzip ${MODEL_FILE} && \
        cp -r ${MODEL_NAME} /build/models/vosk-model && \
        cd / && \
        rm -rf ${TEMP_DIR} && \
        rm -rf /build/models_temp; \
    fi

# 使用更小的JRE镜像作为运行时环境
FROM eclipse-temurin:21-jre

# 安装必要的运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制构建阶段的JAR文件和版本信息
COPY --from=builder /build/target/xiaozhi.server-*.jar /app/
COPY --from=builder /build/app_version.env /app/
# 复制模型文件夹
COPY --from=builder /build/models /app/models

# 设置启动脚本 - JVM 参数按 2.5G 机器做了保守优化，支持通过 JAVA_OPTS 覆盖
RUN cat <<'EOF' > /app/start.sh
#!/bin/bash
set -e

if [ -f /app/app_version.env ]; then
  . /app/app_version.env
fi

DEFAULT_JAVA_OPTS="-Xms384m -Xmx1536m \
  -XX:MaxMetaspaceSize=192m \
  -XX:MaxDirectMemorySize=256m \
  -XX:ReservedCodeCacheSize=128m \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=200 \
  -XX:InitiatingHeapOccupancyPercent=30 \
  -XX:+ParallelRefProcEnabled \
  -XX:+ExitOnOutOfMemoryError \
  -Dfile.encoding=UTF-8"

JAVA_OPTS="${JAVA_OPTS:-$DEFAULT_JAVA_OPTS}"

echo "Starting application version: ${APP_VERSION}"
echo "JAVA_OPTS: ${JAVA_OPTS}"

exec java ${JAVA_OPTS} -jar /app/xiaozhi.server-${APP_VERSION}.jar
EOF
RUN chmod +x /app/start.sh

# 使用 bash 执行启动脚本
CMD ["/bin/bash", "/app/start.sh"]
