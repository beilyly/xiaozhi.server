# Use Eclipse Temurin for both build and runtime stages
FROM eclipse-temurin:21-jdk AS builder

# 添加构建参数，默认使用标准模型
ARG VOSK_MODEL_SIZE=standard
# 添加语言参数，默认使用中文模型，可选：cn 或 en
ARG VOSK_MODEL_LANG=cn

# 安装必要的构建工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    maven \
    wget \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 复制源代码
COPY ./src ./src
COPY ./db ./db
COPY pom.xml ./
# 构建应用
RUN mvn -Dmaven.repo.local=/root/.m2/repository package -DskipTests

# 正确提取项目版本号 - 使用更精确的grep模式匹配项目版本而非父项目版本
RUN APP_VERSION=$(grep -A1 "<artifactId>xiaozhi.server</artifactId>" pom.xml | grep "<version>" | sed -e 's/<version>//' -e 's/<\/version>//' -e 's/[[:space:]]//g') && \
    echo "APP_VERSION=${APP_VERSION}" > /build/app_version.env && \
    cat /build/app_version.env

# 确保模型目录存在
RUN mkdir -p /build/models

# 复制模型文件
COPY ./models/silero_vad.onnx /build/models/silero_vad.onnx

# 复制 Vosk 模型 zip 文件到构建上下文
# 支持从 models 目录或项目根目录复制
# 优先从 models 目录复制，如果不存在则从根目录复制（deploy.sh 会复制到根目录）
# 注意：COPY 指令如果源文件不存在会失败，所以需要确保至少一个位置有文件
# 使用 COPY 复制整个 models 目录（包括所有 zip 文件）
# 手动构建时，zip 文件应该在 models 目录中（如 models/vosk-model-en-us-0.22.zip）
COPY models/ /build/models_source/

# 根据语言参数选择对应的模型文件
# 优先从 models_source 目录（即 models 目录）查找
# 手动构建：文件在 models 目录，会被复制到 /build/models_source/
# deploy.sh：文件在根目录，但 deploy.sh 也会将文件复制到 models 目录（如果需要）
RUN if [ "$VOSK_MODEL_LANG" = "en" ]; then \
        if [ -f "/build/models_source/vosk-model-en-us-0.22.zip" ]; then \
            cp /build/models_source/vosk-model-en-us-0.22.zip /build/vosk-model-en-us-0.22.zip && \
            echo "Using vosk-model-en-us-0.22.zip from models directory"; \
        else \
            echo "Warning: vosk-model-en-us-0.22.zip not found in models directory, will download from network"; \
        fi; \
    else \
        if [ -f "/build/models_source/vosk-model-cn-0.22.zip" ]; then \
            cp /build/models_source/vosk-model-cn-0.22.zip /build/vosk-model-cn-0.22.zip && \
            echo "Using vosk-model-cn-0.22.zip from models directory"; \
        else \
            echo "Warning: vosk-model-cn-0.22.zip not found in models directory, will download from network"; \
        fi; \
    fi

# 下载并准备Vosk模型
RUN mkdir -p /vosk_cache && \
    if [ "$VOSK_MODEL_SIZE" = "small" ]; then \
        # small 模式：目前只支持中文模型 \
        if [ "$VOSK_MODEL_LANG" = "en" ]; then \
            echo "Warning: small model only supports Chinese, using Chinese model instead"; \
            MODEL_NAME="vosk-model-small-cn-0.22"; \
            MODEL_FILE="vosk-model-small-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-small-cn-0.22.zip"; \
        else \
            MODEL_NAME="vosk-model-small-cn-0.22"; \
            MODEL_FILE="vosk-model-small-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-small-cn-0.22.zip"; \
        fi && \
        if [ ! -d "/vosk_cache/${MODEL_NAME}" ]; then \
            echo "Downloading small Vosk model..." && \
            cd /vosk_cache && \
            wget ${MODEL_URL} && \
            unzip ${MODEL_FILE} && \
            rm ${MODEL_FILE}; \
        else \
            echo "Using cached small Vosk model"; \
        fi && \
        cp -r /vosk_cache/${MODEL_NAME} /build/models/vosk-model; \
    else \
        # standard 模式：根据语言参数选择模型 \
        if [ "$VOSK_MODEL_LANG" = "en" ]; then \
            MODEL_NAME="vosk-model-en-us-0.22"; \
            MODEL_FILE="vosk-model-en-us-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-en-us-0.22.zip"; \
        else \
            MODEL_NAME="vosk-model-cn-0.22"; \
            MODEL_FILE="vosk-model-cn-0.22.zip"; \
            MODEL_URL="https://alphacephei.com/vosk/models/vosk-model-cn-0.22.zip"; \
        fi && \
        if [ ! -d "/vosk_cache/${MODEL_NAME}" ]; then \
            if [ -f "/build/${MODEL_FILE}" ]; then \
                echo "Using existing ${MODEL_FILE} from build context..." && \
                cd /vosk_cache && \
                cp /build/${MODEL_FILE} . && \
                unzip ${MODEL_FILE} && \
                rm ${MODEL_FILE}; \
            else \
                echo "${MODEL_FILE} not found, downloading from network..." && \
                cd /vosk_cache && \
                wget ${MODEL_URL} && \
                unzip ${MODEL_FILE} && \
                rm ${MODEL_FILE}; \
            fi; \
        else \
            echo "Using cached standard Vosk model: ${MODEL_NAME}"; \
        fi && \
        cp -r /vosk_cache/${MODEL_NAME} /build/models/vosk-model; \
    fi

# 使用更小的JRE镜像作为运行时环境
FROM eclipse-temurin:21-jre

# 安装必要的运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制构建阶段的JAR文件和版本信息
COPY --from=builder /build/target/xiaozhi.server-*.jar /app/
COPY --from=builder /build/app_version.env /app/
# 复制模型文件夹
COPY --from=builder /build/models /app/models

# 设置启动脚本 - 使用 . 代替 source，并确保使用 bash
RUN echo '#!/bin/bash\n\
if [ -f /app/app_version.env ]; then\n\
  . /app/app_version.env\n\
fi\n\
echo "Starting application version: ${APP_VERSION}"\n\
java -Xms512m -Xmx1024m -jar /app/xiaozhi.server-${APP_VERSION}.jar\n\
' > /app/start.sh && chmod +x /app/start.sh

# 使用 bash 执行启动脚本
CMD ["/bin/bash", "/app/start.sh"]
